# Generated by `support-bi lookml` from metrics/metrics.yml. Edit the YAML, not this file.

view: agg_support_daily {
  sql_table_name: marts.agg_support_daily ;;

  dimension_group: created {
    type: time
    timeframes: [date, week, month, quarter, year]
    convert_tz: no
    datatype: date
    sql: ${TABLE}.created_date ;;
  }

  dimension: product_code {
    type: string
    sql: ${TABLE}.product_code ;;
  }

  dimension: priority {
    type: string
    sql: ${TABLE}.priority ;;
  }

  dimension: tier {
    type: string
    sql: ${TABLE}.tier ;;
  }

  dimension: channel {
    type: string
    sql: ${TABLE}.channel ;;
  }

  measure: cases_total {
    type: sum
    hidden: yes
    sql: ${TABLE}.cases ;;
  }

  measure: csat_responses_total {
    type: sum
    hidden: yes
    sql: ${TABLE}.csat_responses ;;
  }

  measure: csat_satisfied_responses_total {
    type: sum
    hidden: yes
    sql: ${TABLE}.csat_satisfied_responses ;;
  }

  measure: csat_score_sum_total {
    type: sum
    hidden: yes
    sql: ${TABLE}.csat_score_sum ;;
  }

  measure: escalated_cases_total {
    type: sum
    hidden: yes
    sql: ${TABLE}.escalated_cases ;;
  }

  measure: first_response_minutes_sum_total {
    type: sum
    hidden: yes
    sql: ${TABLE}.first_response_minutes_sum ;;
  }

  measure: first_response_sla_met_cases_total {
    type: sum
    hidden: yes
    sql: ${TABLE}.first_response_sla_met_cases ;;
  }

  measure: reopened_cases_total {
    type: sum
    hidden: yes
    sql: ${TABLE}.reopened_cases ;;
  }

  measure: resolution_hours_sum_total {
    type: sum
    hidden: yes
    sql: ${TABLE}.resolution_hours_sum ;;
  }

  measure: case_volume {
    type: number
    sql: ${cases_total} ;;
    label: "Cases opened"
    description: "Number of cases opened in the period."
    group_label: "Support Operations"
    value_format: "#,##0"
  }

  measure: first_response_sla_attainment {
    type: number
    sql: 1.0 * ${first_response_sla_met_cases_total} / NULLIF(${cases_total}, 0) ;;
    label: "First-response SLA attainment"
    description: "Share of cases whose first agent response came within the target for the case's priority and the support tier the customer held when the case was opened."
    group_label: "Support Operations"
    value_format: "0.0%"
  }

  measure: mean_first_response_minutes {
    type: number
    sql: 1.0 * ${first_response_minutes_sum_total} / NULLIF(${cases_total}, 0) ;;
    label: "Mean first-response time"
    description: "Average minutes from case creation to the first agent response."
    group_label: "Support Operations"
    value_format: "#,##0.0"
  }

  measure: mean_resolution_hours {
    type: number
    sql: 1.0 * ${resolution_hours_sum_total} / NULLIF(${cases_total}, 0) ;;
    label: "Mean time to resolve"
    description: "Average hours from case creation to the first resolution."
    group_label: "Support Operations"
    value_format: "#,##0.0"
  }

  measure: escalation_rate {
    type: number
    sql: 1.0 * ${escalated_cases_total} / NULLIF(${cases_total}, 0) ;;
    label: "Escalation rate"
    description: "Share of cases escalated to engineering at least once."
    group_label: "Support Engineering"
    value_format: "0.0%"
  }

  measure: reopen_rate {
    type: number
    sql: 1.0 * ${reopened_cases_total} / NULLIF(${cases_total}, 0) ;;
    label: "Reopen rate"
    description: "Share of resolved cases the customer reopened."
    group_label: "Support Quality"
    value_format: "0.0%"
  }

  measure: csat_score {
    type: number
    sql: 1.0 * ${csat_score_sum_total} / NULLIF(${csat_responses_total}, 0) ;;
    label: "CSAT (mean score)"
    description: "Mean satisfaction score over survey responses; cases without a response are excluded."
    group_label: "Support Quality"
  }

  measure: csat_satisfied_share {
    type: number
    sql: 1.0 * ${csat_satisfied_responses_total} / NULLIF(${csat_responses_total}, 0) ;;
    label: "CSAT (share satisfied)"
    description: "Share of survey responses scoring 4 or 5."
    group_label: "Support Quality"
    value_format: "0.0%"
  }

  measure: csat_response_rate {
    type: number
    sql: 1.0 * ${csat_responses_total} / NULLIF(${cases_total}, 0) ;;
    label: "Survey response rate"
    description: "Share of cases with a satisfaction survey response. Read CSAT alongside it."
    group_label: "Support Quality"
    value_format: "0.0%"
  }
}
